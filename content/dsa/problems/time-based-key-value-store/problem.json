  "hints": [
    "A get at time t wants the newest value written at or before t, not an exact match on t.",
    "Per key, keep the writes in an array. Because timestamps for one key only grow, that array is already sorted by time.",
    "Binary search each key's array for the last timestamp that is at most t. If even the first write is later than t, return an empty string."
  ],
  "complexity": {"time":"O(1) per set, O(log m) per get for m writes of that key","space":"O(total writes)"}
