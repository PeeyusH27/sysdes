  "hints": [
    "A key can be as large as 10^6, so one slot per possible key works but wastes memory. Shrink it: use key % size to pick a bucket.",
    "Different keys can land in the same bucket. Store a small list of [key, value] pairs in each bucket (separate chaining) and scan only that list.",
    "put must replace the value if the key is already in its bucket. get returns -1 when the scan finds nothing; remove deletes the pair if present."
  ],
  "complexity": {"time":"O(n / buckets) per call, O(1) on average with a good bucket count","space":"O(buckets + n)"}
}
