  "order": 6,
  "summary": "Build a fixed-size cache that evicts the entry used the fewest times, breaking ties by the oldest use, in O(1) per call.",
  "kind": "design",
  "className": "LFUCache",
  "tests": [
    {"ops":["LFUCache","put","put","get","put","get","get","put","get","get","get"],"args":[[2],[1,1],[2,2],[1],[3,3],[2],[3],[4,4],[1],[3],[4]],"expected":[null,null,null,1,null,-1,3,null,-1,3,4],"explain":"Capacity 2. Key 1 has 2 uses and key 2 has 1, so put(3) evicts key 2. Keys 1 and 3 both have 2 uses when put(4) arrives; key 1 was used longer ago, so it goes."},
    {"ops":["LFUCache","put","put","get","get","put","get","get","get"],"args":[[2],[1,1],[2,2],[1],[2],[3,3],[1],[2],[3]],"expected":[null,null,null,1,2,null,-1,2,3],"explain":"Keys 1 and 2 are tied at 2 uses. The tie goes to the least recently used one, key 1, so key 1 is evicted."},
    {"ops":["LFUCache","put","get","put","get"],"args":[[0],[0,0],[0],[1,1],[1]],"expected":[null,null,-1,null,-1],"explain":"A cache of capacity 0 stores nothing."},
    {"ops":["LFUCache","put","get","put","get","get"],"args":[[1],[1,1],[1],[2,2],[1],[2]],"expected":[null,null,1,null,-1,2]},
