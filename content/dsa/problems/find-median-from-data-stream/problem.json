  ],
  "hints": [
    "The median only depends on the middle of the sorted order. Split the numbers into a smaller half and a larger half: what do you need from each half?",
    "Keep the smaller half in a max-heap and the larger half in a min-heap. The median is the top of one of them, or the average of both tops.",
    "After each add, rebalance so the max-heap has the same size as the min-heap or exactly one more, and every value in it is at most every value in the min-heap. Pushing into the max-heap and then moving its top to the min-heap guarantees the order part."
  ],
  "complexity": { "time": "O(log n) per addNum (a constant number of heap operations), O(1) per findMedian", "space": "O(n): every number is stored in one of the two heaps" }
}
