  "tests": [
    { "ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [6], [], [2], [], [9], [], [1], []], "expected": [null, null, 6, null, 4, null, 6, null, 4], "explain": "After 6 the median is 6. After 2 the two middle values are 2 and 6, so 4. After 9 the sorted values are 2, 6, 9: the median is 6. After 1 they are 1, 2, 6, 9: (2 + 6) / 2 = 4." },
    { "ops": ["MedianFinder", "addNum", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [1], [2], [], [3], []], "expected": [null, null, null, 1.5, null, 2], "explain": "With 1 and 2 the median is their average, 1.5. Adding 3 makes the middle value 2." },
    { "ops": ["MedianFinder", "addNum", "findMedian"], "args": [[], [-7], []], "expected": [null, null, -7], "explain": "One value is its own median." },
    { "ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [-1], [], [-5], [], [-3], [], [-2], []], "expected": [null, null, -1, null, -3, null, -3, null, -2.5] },
    { "ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [4], [], [4], [], [4], [], [1], [], [4], []], "expected": [null, null, 4, null, 4, null, 4, null, 4, null, 4] },
    { "ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [1], [], [2], [], [3], [], [4], [], [5], [], [6], [], [7], [], [8], []], "expected": [null, null, 1, null, 1.5, null, 2, null, 2.5, null, 3, null, 3.5, null, 4, null, 4.5] },
    { "ops": ["MedianFinder", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian", "addNum", "findMedian"], "args": [[], [10], [], [9], [], [8], [], [7], [], [6], [], [5], [], [4], [], [3], []], "expected": [null, null, 10, null, 9.5, null, 9, null, 8.5, null, 8, null, 7.5, null, 7, null, 6.5] },
