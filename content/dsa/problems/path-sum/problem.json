{
  "title": "Path Sum",
  "difficulty": "Easy",
  "patterns": ["tree-dfs"],
  "js": ["recursion", "linked-list-tree-nodes"],
  "order": 4,
  "summary": "Decide whether some root-to-leaf path adds up to a target sum.",
  "fn": "hasPathSum",
  "params": ["root", "targetSum"],
  "types": { "params": ["TreeNode | null", "number"], "returns": "boolean" },
  "io": { "args": ["tree", null] },
  "tests": [
    { "args": [[3, 9, 6, -2, null, 1, 4, null, 5], 15], "expected": true, "explain": "The path 3 → 9 → -2 → 5 ends at a leaf and adds up to 15." },
    { "args": [[3, 9, 6, -2, null, 1, 4, null, 5], 12], "expected": false, "explain": "3 + 9 = 12, but 9 is not a leaf. The complete paths sum to 15, 10 and 13." },
    { "args": [[], 0], "expected": false, "explain": "An empty tree has no root-to-leaf path at all, not even one that sums to 0." },
    { "args": [[1, 2], 1], "expected": false },
    { "args": [[1, 2], 3], "expected": true },
    { "args": [[-2, null, -3], -5], "expected": true },
    { "args": [[1], 1], "expected": true },
    { "args": [[1, -2, -3, 1, 3, -2, null, -1], -1], "expected": true },
    { "args": [[0, 1, 1], 0], "expected": false },
    { "args": [[-4, 3, 20, -13, null, 10, -18, 9, 1, -4, 4, 7, 5, null, -20, 11, 2, null, null, null, null, null, 0, null, -11, null, -16, null, 20, 14, 7, null, null, null, 4, null, null, -15, null, 1, null, 9, 1, -2, null, -1, 13, null, null, null, null, null, -8, null, null, -8, -14, null, null, null, null, null, -14, null, 10, -11, null, -17, 9, 16, null, null, -19, null, null, 11], 5], "expected": true },
    { "args": [[-4, 3, 20, -13, null, 10, -18, 9, 1, -4, 4, 7, 5, null, -20, 11, 2, null, null, null, null, null, 0, null, -11, null, -16, null, 20, 14, 7, null, null, null, 4, null, null, -15, null, 1, null, 9, 1, -2, null, -1, 13, null, null, null, null, null, -8, null, null, -8, -14, null, null, null, null, null, -14, null, 10, -11, null, -17, 9, 16, null, null, -19, null, null, 11], 0], "expected": false }
  ],
  "hints": [
    "Carry the remaining sum down: below a node, the rest of the path must add up to targetSum - node.val.",
    "Only compare at a leaf, a node with no left and no right child. A node with one child is not the end of a path.",
    "Return false for null. At a leaf, return node.val === targetSum. Otherwise recurse into both children with targetSum - node.val and combine with ||."
  ],
  "complexity": { "time": "O(n): every node is visited at most once", "space": "O(h) for the recursion" }
}
