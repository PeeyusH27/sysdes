{
  "title": "Invert Binary Tree",
  "difficulty": "Easy",
  "patterns": ["tree-dfs", "tree-bfs"],
  "js": ["recursion", "destructuring-spread"],
  "order": 2,
  "summary": "Mirror a binary tree by swapping the left and right child of every node.",
  "fn": "invertTree",
  "params": ["root"],
  "types": { "params": ["TreeNode | null"], "returns": "TreeNode | null" },
  "io": { "args": ["tree"], "returns": "tree" },
  "tests": [
    { "args": [[5, 3, 8, 1, 4, 7, 9]], "expected": [5, 8, 3, 9, 7, 4, 1], "explain": "Every node's children are swapped, so each level reads right to left: [5], [8, 3], [9, 7, 4, 1]." },
    { "args": [[2, 1, 3]], "expected": [2, 3, 1], "explain": "The root keeps its place; its two children trade sides." },
    { "args": [[]], "expected": [], "explain": "Inverting an empty tree gives an empty tree." },
    { "args": [[1]], "expected": [1] },
    { "args": [[1, 2]], "expected": [1, null, 2] },
    { "args": [[1, 2, null, 3, null, 4]], "expected": [1, null, 2, null, 3, null, 4] },
    { "args": [[1, 2, 3, 4, null, null, 5]], "expected": [1, 3, 2, 5, null, null, 4] },
    { "args": [[-1, -2, -3, null, -4, -5]], "expected": [-1, -3, -2, null, -5, -4] },
    { "args": [[1, 1, 1, 1, null, 1]], "expected": [1, 1, 1, null, 1, null, 1] },
    { "args": [[30, 69, 26, 91, 32, 41, null, 6, null, null, 25, 96, 83, null, null, 87, 95, 79, null, null, 47, null, 83, null, 77, 13, 51, 8, null, null, 93, 75, 7, null, null, 39, null, 24, null, null, null, null, null, null, null, null, null, 38]], "expected": [30, 26, 69, null, 41, 32, 91, 83, 96, 25, null, null, 6, 47, null, null, 79, 95, 87, null, null, null, 8, 51, 13, 77, null, 83, null, null, 24, null, 39, null, null, 7, 75, 93, null, null, 38] }
  ],
  "hints": [
    "Inverting a tree means inverting both subtrees and then swapping them.",
    "The base case is the empty tree: inverting null gives null.",
    "Swap in one line: [root.left, root.right] = [invertTree(root.right), invertTree(root.left)], then return root."
  ],
  "complexity": { "time": "O(n): every node is visited once", "space": "O(h) for the recursion" }
}
