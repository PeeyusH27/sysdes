  "hints": [
    "A hash set gives O(1) insert and remove but cannot pick a random member. An array can pick one by index but cannot remove from the middle in O(1).",
    "Keep the values in an array, plus a map from each value to its index in the array. Insert appends; getRandom picks a random index.",
    "To remove a value, overwrite its slot with the last array element, update that element's index in the map, then pop the array. Swap-and-pop keeps the array dense."
  ],
  "complexity": {"time":"O(1) average for insert, remove and getRandom","space":"O(n)"}
}
