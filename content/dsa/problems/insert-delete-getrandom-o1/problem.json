  "tests": [
    {"ops":["RandomizedSet","insert","remove","insert","getRandom","remove","insert","getRandom"],"args":[[],[1],[2],[2],[],[1],[2],[]],"expected":[null,true,false,true,null,true,false,2],"explain":"remove(2) fails because 2 is not in yet. After insert(2) and remove(1) only 2 remains, so getRandom must return 2. When several values are stored the test cannot check which one you return."},
    {"ops":["RandomizedSet","insert","insert","remove","remove","insert","getRandom"],"args":[[],[5],[5],[5],[5],[7],[]],"expected":[null,true,false,true,false,true,7],"explain":"Inserting a duplicate and removing a missing value both return false."},
    {"ops":["RandomizedSet","remove","insert","getRandom","remove","insert"],"args":[[],[0],[0],[],[0],[0]],"expected":[null,false,true,0,true,true],"explain":"Zero is a perfectly good member; do not treat a falsy index or value as missing."},
