    "matrix"
  ],
  "types": {
    "params": [
      "number[][]"
    ],
    "returns": "void"
  },
  "inPlace": 0,
  "tests": [
    {"args":[[[1,2,3],[4,5,6],[7,8,9]]],"expected":[[7,4,1],[8,5,2],[9,6,3]],"explain":"The first row 1 2 3 becomes the last column, read top to bottom. The test checks the matrix after your function returns."},
    {"args":[[[5,1,9,11],[2,4,8,10],[13,3,6,7],[15,14,12,16]]],"expected":[[15,13,2,5],[14,3,4,1],[12,6,8,9],[16,7,10,11]],"explain":"The same idea on a 4 x 4 grid: the bottom-left corner 15 moves to the top-left."},
    {"args":[[[1]]],"expected":[[1]]},
    {"args":[[[1,2],[3,4]]],"expected":[[3,1],[4,2]]},
    {"args":[[[0,0],[0,0]]],"expected":[[0,0],[0,0]]},
    {"args":[[[-1,-2,-3],[-4,-5,-6],[-7,-8,-9]]],"expected":[[-7,-4,-1],[-8,-5,-2],[-9,-6,-3]]},
    {"args":[[[-2,55,16,63,50],[33,78,8,40,-13],[41,-12,48,6,-1],[94,63,-10,-5,-16],[46,33,70,72,-16]]],"expected":[[46,94,41,33,-2],[33,63,-12,78,55],[70,-10,48,8,16],[72,-5,6,40,63],[-16,-16,-1,-13,50]]},
