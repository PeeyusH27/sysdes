  "hints": [
    "Follow one corner: after a clockwise turn the top-left value ends up top-right. Try to express the whole rotation as two simpler moves.",
    "A rotation by 90 degrees clockwise equals a transpose (swap matrix[i][j] with matrix[j][i]) followed by reversing every row.",
    "Transpose only needs the cells above the diagonal (j > i), otherwise you swap each pair twice and undo your work. Then reverse each row in place."
  ],
  "complexity": {"time":"O(n^2): every cell is touched a constant number of times","space":"O(1): swaps happen inside the grid"}
}
