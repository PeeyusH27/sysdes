  "patterns": ["shortest-paths", "dp-2d"],
  "js": ["arrays", "graphs-in-js"],
  "order": 4,
  "summary": "Find the cheapest route between two cities when you may change planes at most k times.",
  "fn": "findCheapestPrice",
  "params": ["n", "flights", "src", "dst", "k"],
  "types": { "params": ["number", "number[][]", "number", "number", "number"], "returns": "number" },
  "tests": [
    { "args": [4, [[0, 1, 100], [1, 2, 100], [2, 3, 100], [0, 2, 500], [1, 3, 600]], 0, 3, 1], "expected": 600, "explain": "With at most 1 stop you may take 2 flights. 0 → 1 → 3 costs 700 and 0 → 2 → 3 costs 600. The 300 route 0 → 1 → 2 → 3 needs 2 stops, so it isn't allowed." },
    { "args": [4, [[0, 1, 100], [1, 2, 100], [2, 3, 100], [0, 2, 500], [1, 3, 600]], 0, 3, 2], "expected": 300, "explain": "Same flights, but now 2 stops are allowed, so 0 → 1 → 2 → 3 for 300 is the cheapest." },
