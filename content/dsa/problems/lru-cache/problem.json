  "tests": [
    {"ops":["LRUCache","put","put","get","put","get","put","get","get","get"],"args":[[2],[1,1],[2,2],[1],[3,3],[2],[4,4],[1],[3],[4]],"expected":[null,null,null,1,null,-1,null,-1,3,4],"explain":"Capacity 2. get(1) makes key 1 the most recent, so put(3) evicts key 2. Then put(4) evicts key 1, the oldest of {1, 3}."},
    {"ops":["LRUCache","put","put","get","put","put","get"],"args":[[2],[2,1],[2,2],[2],[1,1],[4,1],[2]],"expected":[null,null,null,2,null,null,-1],"explain":"Writing an existing key updates it and counts as a use, so it never grows past one entry. put(4) then evicts key 2."},
    {"ops":["LRUCache","put","get","put","get","get"],"args":[[1],[1,10],[1],[2,20],[1],[2]],"expected":[null,null,10,null,-1,20],"explain":"With capacity 1 every new key evicts the previous one."},
