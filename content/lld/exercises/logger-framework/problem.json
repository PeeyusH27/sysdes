          "j"
        ]
      ],
      "expected": [
        null,
        true,
        1,
        [
          "{\"time\":5,\"level\":\"ERROR\",\"logger\":\"api\",\"message\":\"say \\\"hi\\\"\"}"
        ]
      ],
      "explain": "JSON format has the keys in a fixed order and escapes quotes inside the message."
    },
