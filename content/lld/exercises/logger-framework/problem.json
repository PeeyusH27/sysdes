  "order": 11,
  "summary": "Build a logger tree with inherited levels, appenders that each have their own threshold, and a swappable plain or JSON format.",
  "kind": "design",
  "className": "LogManager",
  "samples": 3,
  "tests": [
    {
      "ops": [
        "LogManager",
        "addAppender",
        "log",
        "log",
        "lines"
      ],
      "args": [
        [],
        [
          "mem",
          "root",
          "DEBUG",
          "plain"
        ],
        [
          "app",
          "DEBUG",
          "noise",
          1
        ],
        [
          "app",
          "INFO",
          "hello",
          2
        ],
        [
          "mem"
        ]
      ],
      "expected": [
        null,
        true,
        0,
        1,
        [
          "2 INFO app - hello"
        ]
      ],
      "explain": "The root level is INFO, so the DEBUG call is dropped before any appender sees it. The INFO call is written in plain format."
    },
    {
      "ops": [
        "LogManager",
        "setLevel",
        "effectiveLevel",
        "effectiveLevel",
        "effectiveLevel"
      ],
      "args": [
        [],
        [
          "app",
          "WARN"
        ],
        [
          "app"
        ],
        [
          "app.db"
        ],
        [
          "other"
        ]
      ],
      "expected": [
        null,
        true,
        "WARN",
        "WARN",
        "INFO"
      ],
      "explain": "app.db has no level of its own, so it asks app, which says WARN. other has no ancestor with a level, so it falls through to root's INFO."
    },
    {
      "ops": [
        "LogManager",
        "addAppender",
        "log",
        "lines"
