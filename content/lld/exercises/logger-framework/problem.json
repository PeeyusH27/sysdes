  "hints": [
    "The tree is implied by the names: the parent of a.b.c is a.b. Store a level only for loggers that have one, and find the effective level by walking up with a parent function.",
    "Keep appenders in one map by name, and a second map from logger name to the appender names attached there. A record is checked twice: once against the logger's effective level, once per appender against its threshold.",
    "Make a format a function in a table (plain and json). In log, check the level first and return 0 before building anything, then walk from the logger up to root, writing to each appender that passes its threshold."
  ],
  "complexity": {
    "time": "O(depth of the logger name + appenders on that path) per log call",
    "space": "O(loggers with a level + appenders + lines)"
  }
}
