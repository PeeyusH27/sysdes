  "hints": [
    "Write down the three states and, for each, the events it accepts. What should an event that a state does not accept do to the machine?",
    "Keep the cash logic out of the state code: a plan(amount, stock) function that returns the notes or nothing. Check it before you touch the balance.",
    "Planning notes: for each note value from 100 down, try the most notes you can, and if the rest cannot be paid, try one fewer. The failed-PIN count lives on the account, not on the session."
  ],
  "complexity": {
    "time": "O(1) per event; planning tries at most a few hundred combinations for 4 note values",
    "space": "O(accounts)"
  }
}
