  "hints": [
    "Write the table first: three states, five events, one outcome per cell. If you can fill in every cell on paper, the code is mostly typing.",
    "Give each state its own object with insert, select, cancel and service methods, and let the machine forward every call to its current state object. Then an illegal event is simply a method that returns the rejection.",
    "Only HAS_MONEY ever holds credit, so only its transitions move money. Spend the price, keep the rest as change, set the credit to 0 and switch back to IDLE in the same place; the refund paths do the same without the price."
  ],
  "complexity": {
    "time": "O(1) per call",
    "space": "O(number of slots)"
  }
}