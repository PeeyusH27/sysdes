  "hints": [
    "Do not store snapshots of the whole text. Ask what each action would need to remember in order to reverse itself.",
    "Make each action an object with do and undo, and keep two stacks: actions you can undo and actions you can redo. A delete must remember the exact characters it removed.",
    "A group is just another action whose do runs its children in order and whose undo runs them in reverse. While a group is open, collect actions into it instead of into the history, and only file it when the outermost endGroup arrives."
  ],
  "complexity": {
    "time": "O(length of the affected text) per action, undo or redo",
    "space": "O(total characters typed or removed in the history)"
  }
}