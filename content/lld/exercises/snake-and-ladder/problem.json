  "hints": [
    "Keep the rules that differ in one place: write the three ending rules as small functions from (position, roll, size) to a landing square or null, and look the rule up by name instead of branching inside turn.",
    "A snake and a ladder are the same thing pointing different ways. Store them as maps from a start square to an end square, with Number keys, and check the landing square against both.",
    "Validate everything in the constructor and remember the answer. Then turn applies, in order: the rule, one jump, the win check on the final square, and the turn change (skipped on a six when sixAgain is on and nobody has won)."
  ],
  "complexity": {
    "time": "O(1) per turn after an O(jumps + players) validation",
    "space": "O(jumps + players)"
  }
}
