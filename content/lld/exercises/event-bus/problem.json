  "js": [],
  "order": 6,
  "summary": "Build a publish/subscribe bus with exact and wildcard topics, where one event reaches each interested subscriber exactly once.",
  "kind": "design",
  "className": "EventBus",
  "samples": 3,
  "tests": [
    {
      "ops": [
        "EventBus",
        "subscribe",
        "subscribe",
        "publish",
        "publish",
        "inbox",
        "inbox"
      ],
      "args": [
        [],
        [
          "orders.created",
          "a"
        ],
        [
          "orders.created",
          "b"
        ],
        [
          "orders.created",
          "new order"
        ],
        [
          "orders.shipped",
          "shipped"
        ],
        [
          "a"
        ],
        [
          "b"
        ]
      ],
      "expected": [
        null,
        null,
        null,
        2,
        0,
        [
          [
            "orders.created",
            "new order"
          ]
        ],
        [
          [
            "orders.created",
            "new order"
          ]
        ]
      ],
      "explain": "Both subscribers asked for orders.created, so both receive the first event and the count is 2. The second event has no subscribers, so nothing is delivered."
    },
    {
      "ops": [
        "EventBus",
        "subscribe",
        "publish",
        "publish",
        "publish",
        "inbox"
      ],
      "args": [
        [],
        [
          "orders.*",
          "a"
        ],
        [
          "orders.created",
          "x"
        ],
        [
          "orders.shipped",
          "y"
        ],
        [
          "orders",
          "z"
        ],
        [
          "a"
        ]
      ],
      "expected": [
        null,
        null,
        1,
        1,
        0,
        [
          [
            "orders.created",
            "x"
          ],
          [
            "orders.shipped",
            "y"
          ]
        ]
      ],
      "explain": "orders.* matches every topic that starts with orders. but not the bare topic orders, so the third publish reaches nobody."
    },
    {
      "ops": [
        "EventBus",
        "subscribe",
        "subscribe",
        "publish",
        "inbox"
      ],
      "args": [
        [],
        [
          "orders.*",
