      "expected": [
        null,
        null,
        null,
        1,
        [
          [
            "orders.created",
            "once"
          ]
        ]
      ],
      "explain": "Two patterns of the same subscriber match, yet the event is delivered once and counted once."
    },
    {
      "ops": [
        "EventBus",
        "subscribe",
        "publish",
        "subscribe",
        "publish",
        "inbox"
      ],
      "args": [
        [],
        [
          "news.*",
          "a"
        ],
        [
          "news.sport",
          "early"
