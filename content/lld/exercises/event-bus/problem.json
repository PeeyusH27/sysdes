  "hints": [
    "Keep who is subscribed, what they asked for, and what they received as separate data. Which maps do you need?",
    "Write matches(pattern, topic) as its own small function first. What exactly must a pattern like \"orders.*\" accept and reject?",
    "In publish, loop over subscribers and ask whether any pattern matches. That makes a double match deliver once, and the count is the number of boxes that grew."
  ],
  "complexity": {
    "time": "O(S \u00d7 P) per publish for S subscribers with P patterns each",
    "space": "O(S \u00d7 P + total deliveries)"
  }
